# API service environment values for the long-term Flyway setup.
# Add these to mawa-bes-dev / mawa-bes-prod Cloud Run services.
# The API must not run migrations during normal startup.
MAWA_FLYWAY_STARTUP_ENABLED=false
MAWA_FLYWAY_STARTUP_MODE=disabled
MAWA_FLYWAY_CONTINUE_ON_ERROR=false
MAWA_FLYWAY_JOB_ENABLED=false
