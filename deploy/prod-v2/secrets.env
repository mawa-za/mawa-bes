# ENVIRONMENT_VARIABLE|SECRET_NAME|required|optional
DB_URL|mawa-prod-db-url|required
DB_USERNAME|mawa-prod-db-username|required
DB_PASSWORD|mawa-prod-db-password|required
JWT_SECRET|mawa-prod-jwt-secret|required
ENCRYPTION_SECRET|mawa-prod-encryption-secret|required
MAIL_PASSWORD|mawa-prod-mail-password|required
MAWA_INTERNAL_SERVICE_TOKEN|mawa-prod-internal-service-token|required
MAWA_ADMIN_API_PASSWORD|mawa-prod-admin-api-password|optional
